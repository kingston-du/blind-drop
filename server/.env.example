# Blind Drop — secret names only. This file never contains a real value.
#
# Local:      copy to `server/.env` (git-ignored) and fill in.
# Deployed:   `supabase secrets set --env-file .env` — secrets live in Supabase function
#             secrets, never in the repo (docs/01 §5).
#
# Names must stay in sync with docs/01 §5 and docs/06 §8.

# ── Supabase (printed by `supabase start`; the local values are well-known dev keys) ──────
SUPABASE_URL=                       # e.g. http://127.0.0.1:54321
SUPABASE_ANON_KEY=                  # client-facing key; the app's only Supabase credential
SUPABASE_SERVICE_ROLE_KEY=          # Edge Functions only — bypasses RLS, never ships to a client
SUPABASE_DB_URL=                    # postgres://… used by the pgTAP runner

# ── Sign in with Apple (docs/01 §1, E00-02) ──────────────────────────────────────────────
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=      # the app's bundle id / Services ID
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=         # ES256 JWT client secret, rotated every 6 months
APPLE_SIGN_IN_KEY_ID=                        # Sign in with Apple .p8 key id
APPLE_SIGN_IN_TEAM_ID=                       # Apple Developer team id
APPLE_SIGN_IN_CLIENT_ID=com.blinddrop.app    # native app bundle id
APPLE_SIGN_IN_PRIVATE_KEY=                   # Sign in with Apple .p8, PEM, newlines as \n

# ── Apple Music catalog proxy (docs/06 §4, §8) ───────────────────────────────────────────
APPLE_MUSIC_KEY_ID=                 # 10-char key id of the MusicKit .p8
APPLE_MUSIC_TEAM_ID=                # 10-char Apple Developer team id
APPLE_MUSIC_PRIVATE_KEY=            # contents of the MusicKit .p8, PEM, newlines as \n

# ── APNs, token-based ES256 (docs/01 §1, docs/05) ────────────────────────────────────────
APNS_KEY_ID=                        # 10-char key id of the APNs .p8
APNS_TEAM_ID=                       # 10-char Apple Developer team id
APNS_PRIVATE_KEY=                   # contents of the APNs .p8, PEM, newlines as \n
APNS_TOPIC=                         # the app bundle id, e.g. com.example.blinddrop
APNS_ENVIRONMENT=                   # sandbox | production — must match the build

# ── Spotify (docs/06 §5, §6, §8) ─────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=                  # public; also lands in the iOS Info.plist for PKCE
SPOTIFY_CLIENT_SECRET=              # server only — must never reach the app bundle
# Pilot note (re-checked 2026-08-12; docs/06 §6): development mode is capped at 5
# allowlisted authenticated users and the app owner must have Premium. A 6–12 person pilot
# needs extended quota or must limit Spotify export testing to these five accounts. Replace
# the placeholders in the untracked `server/.env`; never commit real tester addresses here.
# tester-1: name@example.com
# tester-2: name@example.com
# tester-3: name@example.com
# tester-4: name@example.com
# tester-5: name@example.com
