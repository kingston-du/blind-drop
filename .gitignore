# ── Secrets ──────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.p8
*.p12
*.mobileprovision

# ── Node / Deno ──────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
.deno/
deno.lock

# ── Supabase ─────────────────────────────────────────────────────────────────
server/supabase/.temp/
server/supabase/.branches/
server/.supabase/
# The CLI writes .temp/linked-project.json next to wherever it was invoked. Run from the repo
# root by mistake and it lands here, outside the paths above — scratch, never project content.
/supabase/

# ── Xcode ────────────────────────────────────────────────────────────────────
build/
DerivedData/
ios/.build/
# The same derived data, when `-derivedDataPath .build` is passed from the repo root instead of
# from `ios/`. 167MB of build products that `ios/.build/` above already means to exclude.
/.build/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout
.swiftpm/
# Package.resolved is deliberately NOT ignored. docs/01 §1: zero third-party dependencies.
# If it is ignored, adding a package becomes invisible in review; tracked, it shows up in the
# diff and fails the "Assert zero package dependencies" step in CI.

# ── Test output ──────────────────────────────────────────────────────────────
server/supabase/tests/.out/
*.instrumentstrace

# ── macOS ────────────────────────────────────────────────────────────────────
.DS_Store

# ── Snapshot failures ────────────────────────────────────────────────────────
# Written by SnapshotRenderer when a golden does not match: the actual render, the golden it
# was compared against, and a diff with the differing pixels in red. Evidence for the person
# looking at the failure, not a file to commit — the goldens beside it are the committed half.
ios/BlindDropTests/__Snapshots__/__Failures__/

# ── Agent scratch ────────────────────────────────────────────────────────────
# Local agent state and git worktrees. A worktree added here by `git add -A` lands in the
# history as a gitlink nobody can resolve, so it stays ignored.
.claude/*
.claude/worktrees/

# The shared Claude configuration is part of the project and is committed: the project agents
# (`reviewer`, `verifier`) and the `/next-slice` command are how CLAUDE.md §8 is actually
# executed, and an agent definition only one machine has is one that silently does not run.
!.claude/agents/
!.claude/commands/
