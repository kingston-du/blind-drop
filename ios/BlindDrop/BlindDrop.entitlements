<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- docs/13 §8 — the four capabilities, and only these four. -->

	<!-- Alert-only pushes, at most three a day (docs/05). No silent push. -->
	<key>aps-environment</key>
	<string>development</string>

	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>

	<!-- Invite links (docs/04 §3). The domain lands when the pilot group's host is chosen. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:blinddrop.example</string>
	</array>

	<!-- MusicKit is used for exactly one thing: Apple Music playlist export (docs/06 §6).
	     Search and previews go through the server proxy and need nothing from the user. -->
	<key>com.apple.developer.musickit</key>
	<true/>
</dict>
</plist>
