<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- docs/13 §8 — the four capabilities, and only these four. -->

	<!-- Alert-only pushes, at most three a day (docs/05). No silent push. -->
	<key>aps-environment</key>
	<string>development</string>

	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>

	<!-- Invite links: https://blinddrop.app/j/<CODE> (docs/05 §5, docs/16 §3). The claim is
	     the whole domain — Apple's `applinks:` syntax has no path component; the paths live in
	     the apple-app-site-association file at web/.well-known/, and DeepLink refuses every URL
	     on the domain that is not /j/<CODE>. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:blinddrop.app</string>
	</array>

	<!-- MusicKit is used for exactly one thing: Apple Music playlist export (docs/06 §6).
	     Search and previews go through the server proxy and need nothing from the user. -->
	<key>com.apple.developer.musickit</key>
	<true/>
</dict>
</plist>
