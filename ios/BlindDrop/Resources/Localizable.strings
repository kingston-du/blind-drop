/* Localizable.strings — every user-facing string in the app.
 *
 * The source of truth is docs/11-COPY-DECK.md. Rows are transcribed from it verbatim, and a
 * string that is not in the deck does not get invented here: CLAUDE.md §6 says add it to the
 * deck in the same commit. ios/scripts/lint.sh rules 7 and 8 read this file — no exclamation
 * marks, and none of the words the deck's voice section rules out.
 *
 * Rows land as the screens that need them land. This first set is what DesignSystem/ renders:
 * the countdown's own words, the readability bands, and the VoiceOver formats — the components
 * build those themselves because a label is part of the view hierarchy, not part of a screen's
 * copy (docs/12 §2).
 */

/* ── The countdown (docs/11 §The countdown) ────────────────────────────────── */

"countdown.unknown" = "--:--:--";
"countdown.coarse.hours" = "%lld hours";
"countdown.coarse.minutes" = "%lld minutes";
"countdown.coarse.soon" = "under a minute";

/* ── Onboarding (docs/11 §Onboarding) ──────────────────────────────────────── */
/* Sign in is E09-01; the naming, joining and creating rows land with E09-02..04. */

"onboarding.title" = "Blind Drop";
"onboarding.subtitle" = "One song each, every day. Nobody sees anything until 8:00.";
"onboarding.signin.apple" = "Sign in with Apple";

/* ── Errors (docs/11 §Errors) ──────────────────────────────────────────────── */
/* One row per `APIError.copyKey` and `AuthError.copyKey`. A failure the user cannot */
/* read is a failure they cannot act on, so the whole set lands with the first screen */
/* that can fail. */

"error.offline" = "You're offline.";
"error.offline.stale" = "Showing what we had. This may be out of date.";
"error.generic" = "That didn't work. Try again.";
"error.unauthenticated" = "Sign in again to keep playing.";
"error.noprofile" = "Pick a name first.";
"error.nogroup" = "You're not in a group yet.";
"error.notfound" = "That doesn't exist.";
"error.invalidinput" = "Check that and try again.";
"error.wrongphase" = "That's not available right now.";
