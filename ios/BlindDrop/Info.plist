<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- docs/13 §8. Keys that have an INFOPLIST_KEY_ build setting live in the target's
	     build configuration instead; only what cannot be expressed there is here. -->

	<!-- blinddrop:// — invite deep links. Spotify's PKCE callback is the associated HTTPS
	     domain declared in BlindDrop.entitlements (docs/06 §6). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>blinddrop</string>
			</array>
		</dict>
	</array>

	<!-- The one bundled font (docs/07 §3). Bricolage Grotesque is SIL OFL; the licence ships
	     beside it in Resources/Fonts/OFL.txt. It is a variable font and the app sets its
	     wght/wdth/opsz axes at runtime — see DesignSystem/Typography.swift. -->
	<key>UIAppFonts</key>
	<array>
		<string>BricolageGrotesque.ttf</string>
	</array>

	<!-- Only used to check whether the Spotify app is installed before falling back to the
	     web player (docs/06 §5). -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>music</string>
		<string>spotify</string>
	</array>
	<key>NSAppleMusicUsageDescription</key>
	<string>Blind Drop uses Apple Music access only when you export The Record.</string>

	<!-- Public by design — PKCE exists so the client secret never has to ship (docs/06 §8).
	     Injected at build time; never a literal in this file. -->
	<key>SPOTIFY_CLIENT_ID</key>
	<string>$(SPOTIFY_CLIENT_ID)</string>

	<!-- The Supabase publishable anon key, sent as `apikey` on the two /auth/v1 calls
	     (docs/14 §5). Public by design: every table is deny-by-default under RLS and
	     PostgREST is not client-reachable, so the key on its own grants nothing (docs/14 §4).
	     The service role key is a different string and never ships (docs/14 §6).
	     Injected at build time; empty until the project ref is assigned in E14-05. -->
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>

	<!-- There is deliberately no UIBackgroundModes key. docs/13 §8: the app has nothing to do
	     while backgrounded, notifications are alert-only, and adding a background mode is how
	     an app starts feeling like it's watching you. -->

	<!-- Encryption export compliance (docs/14 §10, App Store Connect → App Information).
	     The app only uses HTTPS/ATS (exempt) — no proprietary crypto, no algorithm beyond
	     what the OS provides. Declaring this here answers the question at every build
	     upload instead of it being asked interactively each time. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
